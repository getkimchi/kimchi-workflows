{
  "name": "pi-workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Host-agnostic workflow engine for the PI coding harness (Phase 1: linear function-step tracer bullet).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
